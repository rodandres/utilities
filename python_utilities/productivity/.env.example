# Microsoft Entra ID / App Registration
# For personal Microsoft accounts, "consumers" is the cleanest choice.
MS_TENANT_ID=consumers

# Application (client) ID from your app registration
MS_CLIENT_ID=your_client_id_here

# Microsoft Graph base URL
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Space-separated delegated scopes
MS_GRAPH_SCOPES=openid profile offline_access User.Read Calendars.ReadWrite Tasks.ReadWrite Mail.ReadWrite Mail.Send

# Local token cache file
MS_TOKEN_CACHE_PATH=.token_cache.json